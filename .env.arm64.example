# Copy to .env for docker-compose.arm64.yml (Graviton / Redroid stack).
# Do not commit the real .env.

# Public hostname served by Caddy (TLS via Let's Encrypt). sslip.io works:
# an Elastic IP 203.0.113.10 -> 203-0-113-10.sslip.io
UMBRELLA_HOST=203-0-113-10.sslip.io
ACME_EMAIL=umbrella-os@sslip.io

# umbrella-net gateway = address backend/ws-scrcpy use to reach Redroid's
# host-published ADB port. Also forms the ws-scrcpy udid in stream links.
ANDROID_GATEWAY=172.18.0.1
UMBRELLA_NET_SUBNET=172.18.0.0/16

# Redroid
REDROID_IMAGE=redroid/redroid:14.0.0_64only-latest
REDROID_DATA_DIR=/home/ubuntu/redroid-data
# REDROID_ADB_BIND=0.0.0.0

# Upstream ws-scrcpy commit (see ws-scrcpy/Dockerfile)
WS_SCRCPY_REF=8855ad1184ec7b41f1b28d1b899856f828e09c3e
