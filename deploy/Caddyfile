# Single entrypoint for TV / browser clients.
# Local/dev without TLS: open http://<EC2_PUBLIC_IP>/
# With a domain + DNS A record, replace :80 with your domain for automatic HTTPS.

:80 {
	encode gzip

	handle /api* {
		reverse_proxy backend:4000
	}

	handle /ws {
		reverse_proxy backend:4000
	}

	# noVNC / web stream from budtmo docker-android
	handle_path /novnc/* {
		reverse_proxy android:6080
	}

	handle {
		reverse_proxy frontend:3000
	}
}
